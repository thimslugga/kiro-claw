# Messaging backend: telegram | discord
MESSAGING_BACKEND=discord

# Telegram (only used when MESSAGING_BACKEND=telegram)
TELEGRAM_BOT_TOKEN=

# Discord (only used when MESSAGING_BACKEND=discord)
DISCORD_BOT_TOKEN=
DISCORD_COMMAND_PREFIX=!

# Common
TRIGGER_PATTERN=@jarvis
KIRO_AGENT=JARVIS
CONTAINER_IMAGE=kiro-claw-agent:latest
CONTAINER_TIMEOUT=300
BRAIN_DIR=
EXTRA_HOSTS=

# Comma-separated chat / channel IDs the bot will accept messages from.
# Telegram = numeric chat IDs. Discord = numeric channel IDs.
ALLOWED_CHAT_IDS=

# User ID of the bot owner — only this user is replied to in groups/guilds.
OWNER_USER_ID=

# Default chat ID used by the event processor when a HA event has no explicit target.
DEFAULT_EVENT_CHAT_ID=

PROJECTS=

# Home Assistant base URL used by jarvis-photo (camera snapshots)
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# Webhook security
WEBHOOK_SECRET=
WEBHOOK_ALLOWED_IPS=127.0.0.1,192.168.1.125
WEBHOOK_PORT=8099

# MCP secrets — injected as env vars into container (never written to config files)
MCP_HOME_ASSISTANT_API_ACCESS_TOKEN=
MCP_MCP_OBSIDIAN_OBSIDIAN_API_KEY=
MCP_WORDPRESS_MASJID_WP_API_PASSWORD=
